{
  "name": "gk-cli-branding",
  "version": "1.0.0",
  "description": "CLI de branding personalizado con integración core-js by kellerEToro",
  "main": "src/index.js",
  "bin": {
    "gk-cli": "bin/gk-cli.js"
  },
  "scripts": {
    "start": "node advanced-cli.js interactive",
    "server": "node advanced-cli.js server",
    "server-simple": "node simple-server.js",
    "dev": "NODE_ENV=development node advanced-cli.js server",
    "prod": "NODE_ENV=production node advanced-cli.js server",
    "cli": "node bin/gk-cli.js",
    "interactive": "node advanced-cli.js interactive",
    "test": "node bin/gk-cli.js test",
    "config": "node advanced-cli.js config",
    "workflow": "node advanced-cli.js workflow",
    "api": "node advanced-cli.js api",
    "backup": "node advanced-cli.js backup create",
    "setup": "cp .env.example .env && echo 'Por favor edita el archivo .env con tus configuraciones'",
    "clean": "rm -rf node_modules/.cache && rm -rf logs/*.log && rm -rf data/temp",
    "health": "curl -s http://localhost:3000/api/health",
    "status": "npm run health && echo '✅ Sistema funcionando correctamente'",
    "install-deps": "npm install && npm audit fix --force"
  },
  "keywords": [
    "cli",
    "branding",
    "core-js",
    "keller",
    "kelleretoro",
    "automation"
  ],
  "author": {
    "name": "Oscar Rojas Ortiz | ORO",
    "email": "rojort.os@kelleretoro.com",
    "url": "https://kelleretoro.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "compression": "^1.8.1",
    "core-js": "^3.46.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.0",
    "express-rate-limit": "^8.1.0",
    "figlet": "^1.7.0",
    "helmet": "^7.2.0",
    "inquirer": "^9.2.12",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "ora": "^7.0.1",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.18.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kelleretoro/gk-cli-branding"
  },
  "bugs": {
    "url": "https://github.com/kelleretoro/gk-cli-branding/issues",
    "email": "rojort.os@kelleretoro.com"
  },
  "homepage": "https://kelleretoro.com"
}
