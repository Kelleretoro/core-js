{
  "server": {
    "port": 3000,
    "host": "localhost",
    "ssl": false
  },
  "database": {
    "type": "sqlite",
    "path": "./data/database.sqlite",
    "pool": {
      "min": 2,
      "max": 10
    }
  },
  "jwt": {
    "secret": "your-secret-key",
    "expiresIn": "24h",
    "refreshExpiresIn": "7d"
  },
  "cors": {
    "origin": [
      "http://localhost:3000",
      "http://localhost:8080"
    ],
    "credentials": true
  },
  "apis": {
    "github": {
      "baseURL": "https://api.github.com",
      "timeout": 10000,
      "retries": 3
    },
    "jira": {
      "timeout": 15000,
      "retries": 2
    },
    "gitkraken": {
      "baseURL": "https://gloapi.gitkraken.com/v1",
      "timeout": 10000
    }
  },
  "logging": {
    "level": "info",
    "format": "combined",
    "file": "./logs/app.log",
    "maxSize": "10m",
    "maxFiles": 5
  },
  "cache": {
    "ttl": 300,
    "maxSize": 100,
    "checkPeriod": 600
  },
  "email": {
    "smtp": {
      "host": "smtp.gmail.com",
      "port": 587,
      "secure": false
    }
  },
  "branding": {
    "theme": "default",
    "customColors": {},
    "logo": null,
    "companyName": "kellerEToro"
  },
  "security": {
    "rateLimiting": {
      "windowMs": 900000,
      "max": 100
    },
    "encryption": {
      "algorithm": "aes-256-gcm"
    }
  }
}