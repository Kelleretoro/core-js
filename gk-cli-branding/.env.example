# Configuración de Entorno - gk-cli-branding
# Copiar como .env y completar con valores reales

# === CONFIGURACIÓN DEL SERVIDOR ===
NODE_ENV=development
PORT=3000
HOST=localhost

# === SEGURIDAD ===
JWT_SECRET=tu-clave-secreta-jwt-muy-larga-y-segura-kelleretoro-2025
CONFIG_ENCRYPTION_KEY=clave-encriptacion-configuracion-kelleretoro

# === BASE DE DATOS ===
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/database.sqlite

# === APIs EXTERNAS ===

# GitHub
GITHUB_TOKEN=ghp_tu_token_github_aqui

# Jira
JIRA_DOMAIN=tu-dominio
JIRA_EMAIL=tu-email@kelleretoro.com
JIRA_API_TOKEN=tu_token_jira_aqui

# GitKraken Glo
GITKRAKEN_TOKEN=tu_token_gitkraken_aqui

# === EMAIL (SMTP) ===
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-password-aplicacion
EMAIL_FROM="GK CLI <noreply@kelleretoro.com>"

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://kelleretoro.com

# === LOGGING ===
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# === BRANDING ===
COMPANY_NAME=kellerEToro
THEME=default

# === RATE LIMITING ===
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# === CACHE ===
CACHE_TTL=300
CACHE_MAX_SIZE=100

# === WEBHOOKS ===
WEBHOOK_SECRET=tu-secreto-webhook-kelleretoro

# === BACKUP ===
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# === NOTIFICATIONS ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# === MONITORING ===
SENTRY_DSN=https://tu-sentry-dsn@sentry.io/...
METRICS_ENABLED=true